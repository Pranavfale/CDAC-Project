PORT=8000

AI_INTERNAL_API_KEY=<replace-with-secure-internal-key>

LLM_PROVIDER=groq
GROQ_API_KEY=<replace-with-groq-api-key>
LLM_MODEL=<active-groq-model-id>

LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=1800

AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_MAX_REQUEST_BODY_BYTES=65536